<Window x:Class="ДОМАШКА.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ДОМАШКА - Вход" Height="350" Width="400">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ВХОД В СИСТЕМУ" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Логин:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginBox" Height="30" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Пароль:" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="30" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button x:Name="LoginButton" Content="ВОЙТИ" Width="120" Height="35" 
                    FontSize="14" FontWeight="Bold" Click="LoginButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="RegisterButton" Content="РЕГИСТРАЦИЯ" Width="120" Height="35" 
                    FontSize="14" FontWeight="Bold" Click="RegisterButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="4" Text="" Foreground="Red" 
                   HorizontalAlignment="Center" FontSize="14" Margin="0,10"/>
    </Grid>
</Window>