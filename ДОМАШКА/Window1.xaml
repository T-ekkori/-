<Window x:Class="ДОМАШКА.AccessDeniedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ДОМАШКА" Height="200" Width="300"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ОТКАЗАНО" FontSize="30" FontWeight="Bold" 
                   Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <Button Grid.Row="1" x:Name="RetryButton" Content="ПОПРОБЫВАТЬ СНОВА" 
                Width="150" Height="40" FontSize="14" FontWeight="Bold"
                HorizontalAlignment="Center" Click="RetryButton_Click"/>
    </Grid>
</Window>